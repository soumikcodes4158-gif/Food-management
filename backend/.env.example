# Backend environment template. Copy to backend/.env for local development.
# In AWS every value below is injected from Secrets Manager / the instance
# user-data script, so you never ship a .env file to a server.

ENVIRONMENT=production

DATABASE_URL=postgresql+psycopg://ssfms:CHANGE_ME@localhost:5432/ssfms

# Required in production (config.py refuses to start without it).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Empty is correct when CloudFront serves the site and /api from one domain.
ALLOWED_ORIGINS=

# Bootstrap admin, created only when the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Administrator
